# Copia este archivo a .env.local y rellena los valores del proyecto de Supabase.
# La "publishable key" es pública por diseño (se incluye en el bundle del frontend);
# la seguridad la garantizan las políticas RLS del esquema.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
